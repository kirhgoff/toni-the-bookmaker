# Copy to .env.local for Next.js. Never commit environment files or host credentials.
# Use 127.0.0.1 for this machine only; use 0.0.0.0 for access on a trusted LAN.
HOSTNAME=127.0.0.1
PORT=3000

# Set a long random token whenever the app can be reached by other users.
WEB_AUTH_TOKEN=

# Persistent job metadata, uploads, and completed audiobooks.
AUDIOBOOK_WEB_DATA=./.toni-web
AUDIOBOOK_LIBRARY=./audiobooks
WEB_MAX_UPLOAD_MB=100

# Remote GPU host definitions are read from hosts.local.json (git-ignored).
TONI_HOSTS_FILE=./hosts.local.json
WEB_DEFAULT_HOST=
